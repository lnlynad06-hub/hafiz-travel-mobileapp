<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#CCCCCC" />

    <!-- Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnCloseSheet"
            android:text="@string/select_country_code"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />

        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_close"
            android:padding="@dimen/touch_target_icon_padding"
            android:src="@drawable/ic_back"
            android:rotation="270" />
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginBottom="4dp" />

    <!-- Section: Southeast Asia -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="@string/region_southeast_asia"
        android:textSize="10sp"
        android:textColor="#9E9E9E"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <!-- Malaysia -->
    <LinearLayout android:id="@+id/itemMalaysia"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇲🇾" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_malaysia" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+60" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Singapore -->
    <LinearLayout android:id="@+id/itemSingapore"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇸🇬" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_singapore" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+65" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Indonesia -->
    <LinearLayout android:id="@+id/itemIndonesia"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇮🇩" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_indonesia" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+62" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Brunei -->
    <LinearLayout android:id="@+id/itemBrunei"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇧🇳" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_brunei" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+673" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Thailand -->
    <LinearLayout android:id="@+id/itemThailand"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇹🇭" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_thailand" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+66" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Vietnam -->
    <LinearLayout android:id="@+id/itemVietnam"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇻🇳" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_vietnam" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+84" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Philippines -->
    <LinearLayout android:id="@+id/itemPhilippines"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇵🇭" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_philippines" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+63" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Laos -->
    <LinearLayout android:id="@+id/itemLaos"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇱🇦" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_laos" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+856" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Myanmar -->
    <LinearLayout android:id="@+id/itemMyanmar"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇲🇲" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_myanmar" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+95" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Cambodia -->
    <LinearLayout android:id="@+id/itemCambodia"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇰🇭" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_cambodia" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+855" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Timor-Leste -->
    <LinearLayout android:id="@+id/itemTimorLeste"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:background="?attr/selectableItemBackground">
        <TextView android:layout_width="32dp" android:layout_height="wrap_content"
            android:text="🇹🇱" android:textSize="22sp" android:gravity="center"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:text="@string/country_timor_leste" android:textSize="14sp" android:textColor="#1A1A2E"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+670" android:textSize="14sp" android:textColor="#D81B60" android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>

</ScrollView>
