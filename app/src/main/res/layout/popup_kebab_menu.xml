<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dropdown_popup"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Invoice Item -->
    <LinearLayout
        android:id="@+id/menuItemInvoice"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_invoice"
            app:tint="@color/brand_magenta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/menu_invoice"
            android:textColor="@color/text_dark"
            android:textSize="12.5sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/menuDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="2dp"
        android:background="#F1F5F9" />

    <!-- Receipt Item -->
    <LinearLayout
        android:id="@+id/menuItemReceipt"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_receipt"
            app:tint="#059669" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/menu_receipt"
            android:textColor="@color/text_dark"
            android:textSize="12.5sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
