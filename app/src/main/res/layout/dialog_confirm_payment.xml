<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_dialog_luxury"
    android:elevation="14dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="24dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <!-- Top Badge Icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_gender_badge_female">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_terms_shield"
            app:tint="@color/brand_magenta"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvConfirmPayTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/pay_confirm_dialog_title"
        android:textColor="#18181B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Big Payment Amount -->
    <TextView
        android:id="@+id/tvConfirmPayAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/brand_magenta"
        android:textSize="26sp"
        android:textStyle="bold"
        tools:text="RM 1,000.00" />

    <!-- Subtitle (Package name & Ref) -->
    <TextView
        android:id="@+id/tvConfirmPaySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="#71717A"
        android:textSize="12sp"
        tools:text="Pakej Umrah Sukuk Lite • BKG-260929-35TVAU" />

    <!-- Detail Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_detail_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pay_confirm_purpose_label"
                android:textColor="#71717A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvConfirmPayPurpose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#18181B"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Initial Deposit" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pay_confirm_gateway_label"
                android:textColor="#71717A"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#059669"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="@string/pay_confirm_gateway_name" />
        </LinearLayout>
    </LinearLayout>

    <!-- Secure redirect notice -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/pay_confirm_dialog_secure_notice"
        android:textColor="#71717A"
        android:textSize="11.5sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <!-- Cancel Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelPayConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cancel_dialog"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/remove_favorite_dialog_cancel"
            android:textAllCaps="false"
            android:textColor="#3F3F46"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Confirm Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitPayConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gradient_primary_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/pay_confirm_btn_pay"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
