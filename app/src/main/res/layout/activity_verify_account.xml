<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/verifyRootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp"
        android:gravity="center_horizontal">

        <!-- Top Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/text_dark"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:id="@+id/btnLanguagePicker"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_language_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvActiveLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BM"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="▾"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Brand Header Section -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/circle_bg_light"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/logo"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvVerifyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/verify_account_title"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVerifyDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/verify_account_desc"
                android:textColor="@color/text_gray"
                android:textSize="13.5sp"
                android:lineSpacingMultiplier="1.2"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- 6-Digit OTP Box Grid -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <EditText
                android:id="@+id/etDigit1"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3.5dp"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="LabelFor,Autofill" />

            <EditText
                android:id="@+id/etDigit2"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3.5dp"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="LabelFor,Autofill" />

            <EditText
                android:id="@+id/etDigit3"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3.5dp"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="LabelFor,Autofill" />

            <EditText
                android:id="@+id/etDigit4"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3.5dp"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="LabelFor,Autofill" />

            <EditText
                android:id="@+id/etDigit5"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3.5dp"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="LabelFor,Autofill" />

            <EditText
                android:id="@+id/etDigit6"
                android:layout_width="46dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="3.5dp"
                android:background="@drawable/bg_otp_cell"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:ignore="LabelFor,Autofill" />
        </LinearLayout>

        <!-- Error Text display -->
        <TextView
            android:id="@+id/tvOtpError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/error_red"
            android:textSize="12.5sp"
            android:visibility="gone"
            android:textAlignment="center" />

        <!-- Primary Verify Button with Loading State -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyAccount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_gradient_primary_button"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/verify_account_button"
                android:textColor="@color/white"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <ProgressBar
                android:id="@+id/verifyProgressBar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Resend Code Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvResendPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/verify_account_resend_prompt"
                android:textColor="@color/text_gray"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnResendCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingVertical="4dp"
                android:paddingHorizontal="4dp"
                android:text="@string/verify_account_resend_action"
                android:textColor="@color/pink_dark"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Resend Countdown Label -->
        <TextView
            android:id="@+id/tvResendCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_gray"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <!-- Back to Login Link -->
        <TextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="@string/verify_account_back_login"
            android:textColor="@color/text_dark"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
