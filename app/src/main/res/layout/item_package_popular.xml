<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="190dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="125dp">

            <ImageView
                android:id="@+id/packageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_image_placeholder"
                android:scaleType="centerCrop"
                tools:ignore="ContentDescription" />

            <!-- Heart Favorite Button -->
            <ImageView
                android:id="@+id/packageFavoriteIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/circle_bg_social"
                android:padding="8dp"
                android:src="@drawable/ic_favorite"
                android:clickable="true"
                android:focusable="true"
                android:elevation="4dp"
                tools:ignore="ContentDescription,TouchTargetSizeCheck" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/packageName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:minLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                tools:text="Pakej Umrah Cuti Sekolah &amp; Syawal" />

            <TextView
                android:id="@+id/packageDurationPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/brand_magenta"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="12H 10M • Dari RM 7,990" />

            <TextView
                android:id="@+id/packageHotelDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawableStart="@drawable/ic_hotel"
                android:drawablePadding="4dp"
                android:drawableTint="@color/text_gray"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="50m ke Masjidil Haram" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>