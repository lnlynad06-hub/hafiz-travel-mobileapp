<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_dialog_luxury"
    android:elevation="14dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Top Badge Icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_badge_logout">

        <ImageView
            android:id="@+id/ivLogoutBadge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logout"
            app:tint="#BE185D"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvLogoutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/profile_logout"
        android:textColor="#18181B"
        android:textSize="18.5sp"
        android:textStyle="bold" />

    <!-- Dialog Message -->
    <TextView
        android:id="@+id/tvLogoutMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:paddingHorizontal="8dp"
        android:text="@string/logout_confirm_message"
        android:textColor="#71717A"
        android:textSize="13.5sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <!-- Cancel Button (Secondary) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelLogout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cancel_dialog"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="#3F3F46"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Confirm Logout Button (Primary Magenta) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmLogout"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_logout_confirm"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/profile_logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
