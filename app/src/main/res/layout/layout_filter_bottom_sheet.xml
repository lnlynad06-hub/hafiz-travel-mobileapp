<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filter_sheet_luxury"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_unselected" />

    <!-- Header: Title & Reset Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvFilterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/filter_title"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnResetFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:text="@string/filter_reset"
            android:textColor="@color/brand_magenta"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="480dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp">

            <!-- SECTION 1: KATEGORI -->
            <LinearLayout
                android:id="@+id/sectionCategoryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_category_header"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/filter_all"
                        android:textColor="@color/filter_chip_text"
                        app:chipBackgroundColor="@color/filter_chip_bg"
                        app:chipStrokeColor="@color/filter_chip_stroke"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatUmrah"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_cat_umrah"
                        android:textColor="@color/filter_chip_text"
                        app:chipBackgroundColor="@color/filter_chip_bg"
                        app:chipStrokeColor="@color/filter_chip_stroke"
                        app:chipStrokeWidth="1.5dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCatTour"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_cat_tour"
                        android:textColor="@color/filter_chip_text"
                        app:chipBackgroundColor="@color/filter_chip_bg"
                        app:chipStrokeColor="@color/filter_chip_stroke"
                        app:chipStrokeWidth="1.5dp" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

            <!-- SECTION 2: DESTINASI / NEGARA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_destination_header"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all_destinations"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestTurkey"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_turkey"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestKorea"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_korea"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestJapan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_japan"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestSaudi"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_saudi"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestEurope"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_europe"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestVietnam"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_vietnam"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDestChina"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dest_china"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- SECTION 3: PILIHAN CEPAT HARGA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_price_presets_header"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPricePreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPriceAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPriceBelow3k"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_price_below_3k"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPrice3k6k"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_price_3k_6k"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPrice6k10k"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_price_6k_10k"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPriceAbove10k"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_price_above_10k"
                    android:textColor="@color/filter_chip_text"
                    app:chipBackgroundColor="@color/filter_chip_bg"
                    app:chipStrokeColor="@color/filter_chip_stroke"
                    app:chipStrokeWidth="1.5dp" />

            </com.google.android.material.chip.ChipGroup>

            <!-- SECTION 4: GELANGSAR HARGA TERSUAI (SHOPEE / YOUTUBE BAR STYLE) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filter_custom_slider_header"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSliderRangeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM0 - RM20,000+"
                    android:textColor="@color/brand_magenta"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/priceRangeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:stepSize="250"
                android:valueFrom="0"
                android:valueTo="20000"
                app:haloColor="#26E91E63"
                app:thumbColor="@color/brand_magenta"
                app:thumbElevation="4dp"
                app:thumbRadius="10dp"
                app:trackColorActive="@color/brand_magenta"
                app:trackColorInactive="#E2E8F0"
                app:trackHeight="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMinPriceLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RM0 (Min)"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvMaxPriceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM20,000+ (Max)"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom Apply Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_luxury_button"
            android:text="@string/filter_apply_button"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="16dp" />

    </FrameLayout>

</LinearLayout>
