<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: CRQ Ref & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemRequestNo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="CRQ-20261020-0001" />

            <TextView
                android:id="@+id/tvItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_chip_active"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/brand_magenta"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Dihantar" />
        </LinearLayout>

        <!-- Destination / Package Title -->
        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Pakej Umrah Syawal Mewah" />

        <!-- Travel Dates & Duration -->
        <TextView
            android:id="@+id/tvItemDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_gray"
            android:textSize="12.5sp"
            tools:text="2026-11-01 hingga 2026-11-13 (12 Hari)" />

        <!-- Travellers & Rooms Info -->
        <TextView
            android:id="@+id/tvItemTravellersInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dark"
            android:textSize="12.5sp"
            tools:text="4 Jemaah • Bilik Quad" />

        <!-- Official Quotation Highlight (if available) -->
        <TextView
            android:id="@+id/tvItemQuotationHighlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Sebut Harga Rasmi: RM 24,500.00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#F0E0E6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemActionHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/request_tap_details"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_view_arrow"
                android:textColor="@color/brand_magenta"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
