<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Shared Floating Luxury Bottom Navigation Dock -->
    <include
        layout="@layout/layout_luxury_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Pink hero - replaces the old plain top bar -->
    <LinearLayout
        android:id="@+id/favoriteHeroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_card"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/favorite_hero_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.9"
            android:text="@string/favorite_hero_subtitle"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Skeleton Shimmer Loading Placeholder -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/favoriteShimmerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.6"
        app:shimmer_highlight_alpha="1.0"
        app:shimmer_duration="1200"
        app:layout_constraintTop_toBottomOf="@id/favoriteHeroCard"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_skeleton_vertical_card" />
            <include layout="@layout/item_skeleton_vertical_card" />
            <include layout="@layout/item_skeleton_vertical_card" />

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/favoriteRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="96dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/favoriteHeroCard"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Nicer empty state: heart icon + message, centered in the space below the hero -->
    <LinearLayout
        android:id="@+id/favoriteEmptyContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/favoriteHeroCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/field_border"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/favoriteEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/favorite_empty_state"
            android:textColor="@color/text_gray"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
