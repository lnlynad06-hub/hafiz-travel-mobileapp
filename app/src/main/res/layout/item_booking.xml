<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="10dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. Header Row: Left = Booking Status Badge, Right = Vertical Kebab Menu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/itemBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnBookingKebabMenu"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:textColor="@color/status_pending_text"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="PENDING CONFIRMATION" />

            <ImageView
                android:id="@+id/btnBookingKebabMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_more_options"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_dark" />

        </RelativeLayout>

        <!-- 2. Package Title -->
        <TextView
            android:id="@+id/itemBookingPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Umrah Sukuk LITE" />

        <!-- 3. Trip Information: Travel Date • Duration • Pax -->
        <TextView
            android:id="@+id/itemBookingTripMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            tools:text="07 Nov 2026 • 12 days 11 nights • 2 pax" />

        <!-- 3b. Room Assignment Status Badge -->
        <TextView
            android:id="@+id/itemRoomAssignmentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:textColor="@color/status_pending_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            tools:text="Room Assignment: Pending Verification" />

        <!-- Cancellation & Refund Status Notice Card -->
        <LinearLayout
            android:id="@+id/layoutCancellationNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_warning_light"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCancellationNoticeIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="#D97706" />

                <TextView
                    android:id="@+id/tvCancellationNoticeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:textColor="#92400E"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="Cancellation Review in Progress" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCancellationNoticeMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#78350F"
                android:textSize="11.5sp"
                tools:text="Your cancellation request has been submitted and is awaiting review by Hafiz Travel." />

            <TextView
                android:id="@+id/tvCancellationNoticeMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#B45309"
                android:textSize="11sp"
                tools:text="Submitted: 2026-10-14 • Ref: BKG-1234 • Paid: RM 3,000" />

        </LinearLayout>

        <!-- 4. Single-Surface Payment Summary Matrix -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_detail_card"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 2-Column Financial Summary (Paid & Outstanding Balance) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Column 1: Total Paid -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:text="@string/booking_label_paid_amount"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/itemBookingPaidAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/status_paid_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeStepGranularity="1sp"
                        tools:text="RM 5,925" />

                </LinearLayout>

                <!-- Column 2: Outstanding Balance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:text="@string/booking_label_balance_due"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/itemBookingOutstandingAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="end"
                        android:textColor="@color/brand_magenta"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="11sp"
                        app:autoSizeMaxTextSize="15sp"
                        app:autoSizeStepGranularity="1sp"
                        tools:text="RM 15,375" />

                </LinearLayout>

            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/itemPaymentProgressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="40"
                android:progressBackgroundTint="#E2E8F0"
                android:progressTint="@color/brand_magenta" />

            <!-- Grand Total directly below progress bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/itemBookingGrandTotal"
                    android:layout_marginEnd="8dp"
                    android:letterSpacing="0.03"
                    android:text="@string/booking_label_grand_total_summary"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/itemBookingGrandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="15sp"
                    app:autoSizeStepGranularity="1sp"
                    tools:text="RM 21,300" />

            </RelativeLayout>

        </LinearLayout>

        <!-- 5. Action Buttons: Pay Now (Primary) + Documents & Details Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- 1. Pay Now (Primary CTA full-width action, Magenta) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemPayNow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/booking_btn_pay_now"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_magenta"
                app:cornerRadius="12dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_card"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                tools:text="Pay now" />

            <!-- 2. Dual Action Row: Documents + View Details -->
            <LinearLayout
                android:id="@+id/layoutItemSecondaryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnItemManageDocs"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minHeight="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/booking_btn_documents"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F1F5F9"
                    app:cornerRadius="12dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnItemDetails"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:minHeight="48dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/booking_btn_details"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F1F5F9"
                    app:cornerRadius="12dp"
                    app:elevation="0dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
