<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 1. Top Bar: Category Pill, Booking No & Booking Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvItemCategoryTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:text="@string/booking_category_umrah"
                    android:textColor="@color/brand_magenta"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/itemBookingNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="BKG-260928-OIUEXZ" />

                <ImageView
                    android:id="@+id/btnItemCopyBookingNo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/booking_success_copy_no"
                    android:padding="2dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_muted" />

            </LinearLayout>

            <TextView
                android:id="@+id/itemBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4.5dp"
                android:textColor="#D97706"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="MENUNGGU PENGESAHAN" />

        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#F1F5F9" />

        <!-- 2. Package Hero Title & Travel Meta -->
        <TextView
            android:id="@+id/itemBookingPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Pakej Umrah Ziarah VIP Cuti Sekolah" />

        <TextView
            android:id="@+id/itemBookingTripMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:drawablePadding="6dp"
            android:textColor="@color/text_gray"
            android:textSize="12.5sp"
            tools:text="12 Nov 2026 • 12 Hari 10 Malam • 2 Jemaah" />

        <!-- 3. Two-Stage Payment & Financial Matrix Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_detail_card"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Payment Stage & Stage Status Badge -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/itemPaymentStageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/booking_label_stage_deposit"
                    android:textColor="@color/brand_magenta"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/itemPaymentStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp"
                    android:text="@string/payment_status_deposit_partial"
                    android:textColor="#D97706"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    tools:text="DEPOSIT SEPARA" />

            </RelativeLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/itemPaymentProgressBar"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="40"
                android:progressTint="@color/brand_magenta"
                android:progressBackgroundTint="#E2E8F0" />

            <!-- Payment Stage Breakdown Detail -->
            <TextView
                android:id="@+id/itemPaymentStageDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                tools:text="Deposit: RM 400.00 / RM 1,000.00 (Baki Deposit: RM 600.00)" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#E2E8F0" />

            <!-- Financial Summary Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Paid Amount -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/booking_label_paid_amount"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/itemBookingPaidAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#059669"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="RM 400.00" />

                </LinearLayout>

                <!-- Outstanding Balance -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/booking_label_balance_due"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <TextView
                        android:id="@+id/itemBookingOutstandingAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/brand_magenta"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="RM 9,600.00" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- 4. Pay Now Primary Action (Visible when outstanding balance exists) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemPayNow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/booking_btn_pay_now"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_card"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white"
            app:backgroundTint="@color/brand_magenta"
            app:cornerRadius="12dp"
            app:elevation="2dp"
            tools:text="Pay Now" />

        <!-- 5. Secondary Action Buttons (Invoice, Receipt, Documents) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- View Invoice Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemViewInvoice"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/booking_btn_invoice"
                android:textAllCaps="false"
                android:textColor="@color/brand_magenta"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                app:strokeColor="@color/brand_magenta"
                app:cornerRadius="10dp" />

            <!-- View Receipt Button (State-Aware: only when payments exist) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemViewReceipt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/booking_btn_receipt"
                android:textAllCaps="false"
                android:textColor="#0284C7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                app:strokeColor="#0284C7"
                app:cornerRadius="10dp" />

            <!-- Manage Documents Button (Direct Click) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemManageDocs"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/booking_btn_documents"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- 6. Destructive / Secondary Action: Cancel Booking (Visible when eligible) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemCancelBooking"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/booking_btn_cancel"
            android:textAllCaps="false"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:visibility="gone"
            app:strokeColor="#FCA5A5"
            app:strokeWidth="1dp"
            app:backgroundTint="#FEF2F2"
            app:cornerRadius="10dp"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
