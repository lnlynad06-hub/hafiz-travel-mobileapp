<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Header: Booking No & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/itemBookingNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/brand_magenta"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="BKG-260928-OIUEXZ" />

                <ImageView
                    android:id="@+id/btnItemCopyBookingNo"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_muted"
                    android:contentDescription="Salin" />

            </LinearLayout>

            <TextView
                android:id="@+id/itemBookingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#D97706"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="MENUNGGU PENGESAHAN" />

        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#F1F5F9" />

        <!-- Package Name -->
        <TextView
            android:id="@+id/itemBookingPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Pakej Umrah Ziarah Premium" />

        <!-- Trip Details Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Departure Date -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_label_departure"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/itemBookingDepartureDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_dark"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    tools:text="12 Nov 2026" />

            </LinearLayout>

            <!-- Total Price -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_label_grand_total"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/itemBookingTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/brand_magenta"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="RM 43,444.00" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#F1F5F9" />

        <!-- Card Action Buttons (Invoice, Receipt, Documents) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- View Invoice Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemViewInvoice"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/booking_btn_invoice"
                android:textAllCaps="false"
                android:textColor="@color/brand_magenta"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="false"
                app:strokeColor="@color/brand_magenta"
                app:cornerRadius="10dp" />

            <!-- View Receipt Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemViewReceipt"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/booking_btn_receipt"
                android:textAllCaps="false"
                android:textColor="#0284C7"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="false"
                app:strokeColor="#0284C7"
                app:cornerRadius="10dp" />

            <!-- Manage Documents Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemManageDocs"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/booking_btn_documents"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="false"
                app:backgroundTint="#F3F4F6"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
