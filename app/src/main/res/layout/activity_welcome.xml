<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp">

        <!-- Overlapping image stack area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/imageStack"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/imageLeft"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="50dp"
                android:background="@drawable/circle_bg_light"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                android:elevation="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imageRight"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_marginEnd="30dp"
                android:layout_marginTop="50dp"
                android:background="@drawable/circle_bg_light"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                android:elevation="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imageCenter"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/circle_bg_accent"
                android:padding="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_putih"
                android:elevation="6dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/trustText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_trust_text"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/imageStack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/welcome_title"
            android:textColor="@color/text_dark"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/trustText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/welcome_subtitle"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/titleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/languageSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:flexWrap="wrap"
            app:justifyContent="center"
            app:layout_constraintTop_toBottomOf="@id/subtitleText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/btnLangEnglish"
                style="@style/LangPill"
                android:layout_margin="4dp"
                android:text="English"
                tools:ignore="TouchTargetSizeCheck"
                tools:layout_editor_absoluteX="4dp"
                tools:layout_editor_absoluteY="4dp" />

            <TextView
                android:id="@+id/btnLangMalay"
                style="@style/LangPill"
                android:layout_margin="4dp"
                android:text="Bahasa Melayu"
                tools:ignore="TouchTargetSizeCheck"
                tools:layout_editor_absoluteX="91dp"
                tools:layout_editor_absoluteY="4dp" />

            <TextView
                android:id="@+id/btnLangArabic"
                style="@style/LangPill"
                android:layout_margin="4dp"
                android:text="العربية"
                tools:ignore="TouchTargetSizeCheck"
                tools:layout_editor_absoluteX="223dp"
                tools:layout_editor_absoluteY="4dp" />

            <TextView
                android:id="@+id/btnLangKorean"
                style="@style/LangPill"
                android:layout_margin="4dp"
                android:text="한국어"
                tools:ignore="TouchTargetSizeCheck"
                tools:layout_editor_absoluteX="35dp"
                tools:layout_editor_absoluteY="51dp" />

            <TextView
                android:id="@+id/btnLangJapanese"
                style="@style/LangPill"
                android:layout_margin="4dp"
                android:text="日本語"
                tools:ignore="TouchTargetSizeCheck"
                tools:layout_editor_absoluteX="115dp"
                tools:layout_editor_absoluteY="51dp" />

            <TextView
                android:id="@+id/btnLangChinese"
                style="@style/LangPill"
                android:layout_margin="4dp"
                android:text="中文"
                tools:ignore="TouchTargetSizeCheck"
                tools:layout_editor_absoluteX="198dp"
                tools:layout_editor_absoluteY="51dp" />

        </com.google.android.flexbox.FlexboxLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/getStartedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="@string/welcome_start_now"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="@color/pink_primary"
            app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/languageSelector"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/loginLinkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:text="@string/welcome_already_have_account"
            android:textColor="@color/pink_dark"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/getStartedButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>