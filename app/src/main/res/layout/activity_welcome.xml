<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6">

    <!-- SCREEN 1: Start Exploring (Existing Screen) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layoutStartExploring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#FAF9F6">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Top Header: Refined Brand Mark & Subtle Language Switcher -->
            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|start"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/logoTop"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:letterSpacing="0.08"
                        android:text="@string/welcome_brand_name"
                        android:textAlignment="viewStart"
                        android:textColor="#141414"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Discreet Luxury Language Selector -->
                <LinearLayout
                    android:id="@+id/btnLanguagePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_luxury_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActiveLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EN"
                        android:textColor="#141414"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="▾"
                        android:textColor="#888888"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cinematic Editorial Hero Card with Rotating Package Showcase -->
            <androidx.cardview.widget.CardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#EFECE6"
                app:layout_constraintDimensionRatio="1:1.05"
                app:layout_constraintHeight_min="320dp"
                app:layout_constraintHeight_max="430dp"
                app:layout_constraintTop_toBottomOf="@id/topBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:id="@+id/heroCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Rich Scenic Visual (Auto-rotating packages) -->
                    <ImageView
                        android:id="@+id/heroImageMain"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_turkiye" />

                    <!-- Gentle Editorial Gradient Scrim -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/scrim_editorial_hero" />

                    <!-- Understated Floating Tag with Subtle Magenta Accent (Bottom-Left) -->
                    <LinearLayout
                        android:id="@+id/heroTagContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_editorial_tag"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/circle_bg_accent" />

                        <TextView
                            android:id="@+id/tvHeroTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.08"
                            tools:text="TURKIYE"
                            android:textColor="#141414"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Editorial Category Eyebrow in Brand Magenta -->
            <TextView
                android:id="@+id/eyebrowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.12"
                android:text="@string/welcome_eyebrow"
                android:textColor="#D81B60"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/heroCard"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Luxury Editorial Title -->
            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.1"
                android:text="@string/welcome_title"
                android:textColor="#141414"
                android:textSize="23sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/eyebrowText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Calming Sophisticated Subtext -->
            <TextView
                android:id="@+id/subtitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/welcome_subtitle"
                android:textColor="#595959"
                android:textSize="13.5sp"
                app:layout_constraintTop_toBottomOf="@id/titleText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Perfectly Aligned Equal-Width Category Chips (1-Row, Balanced) -->
            <LinearLayout
                android:id="@+id/categoryChipsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3"
                app:layout_constraintTop_toBottomOf="@id/subtitleText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/chipWorldwide"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_minimal"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="4dp"
                    android:text="@string/welcome_chip_worldwide"
                    android:textColor="#2A2A2A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipUmrah"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_minimal"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="4dp"
                    android:text="@string/welcome_chip_umrah"
                    android:textColor="#2A2A2A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipCustom"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_minimal"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingHorizontal="4dp"
                    android:text="@string/welcome_chip_custom"
                    android:textColor="#2A2A2A"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Primary CTA: Refined Magenta Luxury Gradient Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/getStartedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_luxury_button"
                android:letterSpacing="0.04"
                android:text="@string/welcome_start_now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/categoryChipsLayout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Grouped Secondary Authentication Options: Anchored directly below CTA without awkward voids -->
            <LinearLayout
                android:id="@+id/authGroupContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/getStartedButton"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.0">

                <!-- Secondary Action 1: Already have an account? Log In -->
                <TextView
                    android:id="@+id/loginLinkText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="#4A4A4A"
                    android:textSize="13sp" />

                <!-- Secondary Action 2: Don't have an account? Create Account -->
                <TextView
                    android:id="@+id/signupLinkText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:minHeight="32dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="3dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:textColor="#4A4A4A"
                    android:textSize="13sp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

        <!-- SCREEN 2: Full-Screen Prayer Times & Qibla Setup -->
    <LinearLayout
        android:id="@+id/layoutPrayerSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF9F6"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/welcome_brand_name"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrayerStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_badge"
                android:letterSpacing="0.08"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/onboarding_step_1_of_2"
                android:textColor="#D81B60"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Content Area (Minimalist, spacious) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Luxury Icon Badge -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_onboarding_icon_circle">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_kiblat"
                    app:tint="#D81B60"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvPrayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/onboarding_prayer_title"
                android:textColor="#141414"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvPrayerDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onboarding_prayer_desc"
                android:textColor="#595959"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary Action: Enable -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnablePrayer"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_luxury_button"
                android:letterSpacing="0.03"
                android:text="@string/onboarding_action_enable"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Secondary Action: Maybe Later -->
            <TextView
                android:id="@+id/btnSkipPrayer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_action_maybe_later"
                android:textColor="#757575"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- SCREEN 3: Full-Screen Notification Setup -->
    <LinearLayout
        android:id="@+id/layoutNotificationSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF9F6"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <!-- Top Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/welcome_brand_name"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotifStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_onboarding_badge"
                android:letterSpacing="0.08"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/onboarding_step_2_of_2"
                android:textColor="#D81B60"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center Content Area (Minimalist, spacious) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- Luxury Icon Badge -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_onboarding_icon_circle">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notifications"
                    app:tint="#D81B60"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvNotifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/onboarding_notif_title"
                android:textColor="#141414"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvNotifDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/onboarding_notif_desc"
                android:textColor="#595959"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primary Action: Allow Notifications -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAllowNotif"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_luxury_button"
                android:letterSpacing="0.03"
                android:text="@string/onboarding_action_allow_notif"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Secondary Action: Maybe Later -->
            <TextView
                android:id="@+id/btnSkipNotif"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/onboarding_action_maybe_later"
                android:textColor="#757575"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>