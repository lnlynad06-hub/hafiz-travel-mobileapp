<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/docViewerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnDocViewerClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/white"
            android:contentDescription="@string/dialog_btn_close" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnDocViewerClose"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDocViewerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/doc_passport_copy"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvDocViewerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="#A0A0A0"
                android:textSize="11.5sp"
                android:ellipsize="middle"
                android:maxLines="1" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:id="@+id/flDocViewerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A0A">

        <!-- Zoomable Document Image -->
        <ImageView
            android:id="@+id/ivDocViewerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:visibility="gone"
            android:contentDescription="@string/doc_passport_copy" />

        <!-- Loading Indicator State -->
        <LinearLayout
            android:id="@+id/llDocViewerLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pbDocViewer"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/brand_magenta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/doc_viewer_loading"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Error State with Retry -->
        <LinearLayout
            android:id="@+id/llDocViewerError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_warning"
                app:tint="#EF4444"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvDocViewerErrorMsg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/doc_viewer_load_failed"
                android:textColor="#EF4444"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDocViewerRetry"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="16dp"
                android:text="@string/doc_viewer_retry"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:backgroundTint="@color/brand_magenta"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- Subtle Zoom Hint Pill at Bottom -->
        <TextView
            android:id="@+id/tvDocViewerZoomHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_zoom_hint_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/doc_viewer_zoom_hint"
            android:textColor="#E0E0E0"
            android:textSize="10.5sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
