<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTraveller"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_detail_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 1. Header Bar: Avatar, Index, Live Name Preview, Delete, Expand/Collapse -->
    <LinearLayout
        android:id="@+id/headerRowTraveller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar Circle -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_bg_light">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_profile"
                app:tint="@color/pink_dark"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Traveller Title & Live Name Preview -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTravellerIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Jemaah 2" />

            <TextView
                android:id="@+id/txtTravellerNamePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/passenger_default_preview_name"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Delete Action Button -->
        <TextView
            android:id="@+id/btnDeleteTraveller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_delete_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="@string/passenger_delete"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Expand / Collapse Chevron -->
        <ImageView
            android:id="@+id/imgExpandCollapse"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_gray"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- 2. Expandable Form Body -->
    <LinearLayout
        android:id="@+id/layoutExpandableBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- ==================== SUB-SECTION 1: MAKLUMAT PERIBADI ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/pink_dark"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/passenger_sub_personal_info"
                android:textColor="@color/pink_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Full Name (Outline Box, No Mr section) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/passenger_field_name_label"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/box_stroke_selector"
            app:boxBackgroundColor="@color/box_bg_selector"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxStrokeErrorColor="@color/error_red"
            app:hintEnabled="true"
            app:errorEnabled="false"
            app:errorIconDrawable="@null"
            app:startIconDrawable="@drawable/ic_profile"
            app:startIconTint="@color/pink_dark">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="12dp"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/input_text"
                android:textColorHint="@color/input_hint"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/errorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/error_red"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Sila isi nama penuh mengikut IC / Pasport." />

        <!-- Date of Birth (Exact Edit Profile Wheel Picker Field) -->
        <LinearLayout
            android:id="@+id/fieldDobContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_luxury_form_field"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/pink_dark"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passenger_field_dob_label"
                    android:textColor="@color/text_gray"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvDobValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_field_dob_placeholder"
                    android:textColor="@color/input_hint"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDobAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_pending"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/pink_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="32 tahun"
                tools:visibility="visible" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Child Bed Option (For Tour Package children aged 2-11) -->
        <LinearLayout
            android:id="@+id/layoutChildBedOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_luxury_form_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/pink_dark"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/child_bed_option_label"
                    android:textColor="@color/text_gray"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvChildBedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/with_bed"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchChildBed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- Gender (Exact Edit Profile Gender Sheet Field) -->
        <LinearLayout
            android:id="@+id/fieldGenderContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_luxury_form_field"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:id="@+id/ivGenderBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_profile"
                android:visibility="gone"
                tools:src="@drawable/ic_gender_male"
                tools:visibility="visible"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passenger_field_gender_label"
                    android:textColor="@color/text_gray"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvGenderValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_field_gender_placeholder"
                    android:textColor="@color/input_hint"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Nationality (Exact Edit Profile Searchable Country Field) -->
        <LinearLayout
            android:id="@+id/fieldNationalityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_luxury_form_field"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="58dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tvNationalityFlag"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textSize="18sp"
                android:visibility="gone"
                tools:text="🇲🇾"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/passenger_field_nationality_label"
                    android:textColor="@color/text_gray"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tvNationalityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/profile_field_nationality_placeholder"
                    android:textColor="@color/input_hint"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_gray"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- IC / MyKad Section -->
        <LinearLayout
            android:id="@+id/layoutIcSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/icLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/passenger_field_ic_label"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxBackgroundColor="@color/box_bg_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:boxStrokeErrorColor="@color/error_red"
                app:hintEnabled="true"
                app:errorEnabled="false"
                app:errorIconDrawable="@null"
                app:startIconDrawable="@drawable/ic_card"
                app:startIconTint="@color/pink_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputIc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:inputType="number"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_hint"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/errorIc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/error_red"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Sila isi no. IC / MyKad." />

        </LinearLayout>


        <!-- ==================== SUB-SECTION 2: DOKUMEN PASPORT ANTARABANGSA ==================== -->
        <LinearLayout
            android:id="@+id/layoutPassportSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Decorative Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="#E5E9EC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_doc_passport"
                    app:tint="@color/pink_dark"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/passenger_sub_passport_info"
                    android:textColor="@color/pink_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/passenger_passport_hint_validity"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />

            <!-- Passport Number (Outline Box) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passportLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/passenger_field_passport_label"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxBackgroundColor="@color/box_bg_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:boxStrokeErrorColor="@color/error_red"
                app:hintEnabled="true"
                app:errorEnabled="false"
                app:errorIconDrawable="@null"
                app:startIconDrawable="@drawable/ic_doc_passport"
                app:startIconTint="@color/pink_dark">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputPassport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_hint"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/errorPassport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/error_red"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Sila isi no. pasport." />

            <!-- Passport Expiry Date (Exact Edit Profile Wheel Picker Field) -->
            <LinearLayout
                android:id="@+id/fieldPassportExpiryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_luxury_form_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/pink_dark"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/passenger_field_passport_expiry_label"
                        android:textColor="@color/text_gray"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvPassportExpiryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_field_passport_expiry_placeholder"
                        android:textColor="@color/input_hint"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_gray"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorPassportExpiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/error_red"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Sila pilih tarikh luput pasport." />

            <!-- Passport Issuing Country (Exact Edit Profile Searchable Country Field) -->
            <LinearLayout
                android:id="@+id/fieldIssuingCountryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_luxury_form_field"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/tvIssuingCountryFlag"
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:textSize="18sp"
                    android:visibility="gone"
                    tools:text="🇲🇾"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/passenger_field_issuing_country_label"
                        android:textColor="@color/text_gray"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tvIssuingCountryValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_field_issuing_country_placeholder"
                        android:textColor="@color/input_hint"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/text_gray"
                    android:contentDescription="@null" />
            </LinearLayout>

        </LinearLayout>


        <!-- ==================== SUB-SECTION 3: PILIHAN TAMBAHAN & MAHRAM ==================== -->
        <LinearLayout
            android:id="@+id/layoutExtraSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Decorative Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="14dp"
                android:background="#E5E9EC" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_users"
                    app:tint="@color/pink_dark"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/passenger_sub_extra_info"
                    android:textColor="@color/pink_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Clothes / Abaya Size -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutClothesSizeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/passenger_field_clothes_size_label"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/box_stroke_selector"
                app:boxBackgroundColor="@color/box_bg_selector"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintEnabled="true"
                app:startIconDrawable="@drawable/ic_packing_luggage"
                app:startIconTint="@color/pink_dark">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/inputClothesSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp"
                    android:inputType="none"
                    android:textColor="@color/input_text"
                    android:textColorHint="@color/input_hint"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mahram Section -->
            <LinearLayout
                android:id="@+id/layoutMahramSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/mahramLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/passenger_field_mahram_label"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:boxBackgroundColor="@color/box_bg_selector"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:hintEnabled="true"
                    app:startIconDrawable="@drawable/ic_users"
                    app:startIconTint="@color/pink_dark">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/inputMahram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="12dp"
                        android:inputType="none"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/relationshipLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/passenger_field_mahram_relation_label"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/box_stroke_selector"
                    app:boxBackgroundColor="@color/box_bg_selector"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:hintEnabled="true"
                    app:startIconDrawable="@drawable/ic_users"
                    app:startIconTint="@color/pink_dark">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/inputRelationship"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="12dp"
                        android:inputType="textCapWords"
                        android:textColor="@color/input_text"
                        android:textColorHint="@color/input_hint"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
