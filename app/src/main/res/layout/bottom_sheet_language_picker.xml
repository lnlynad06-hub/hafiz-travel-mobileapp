<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_luxury"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="32dp">

    <!-- Subtle Drag Pill -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#DCDCE2" />

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btnCloseSheet"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/language_picker_title"
                android:textColor="#141414"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/language_picker_subtitle"
                android:textColor="#757575"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Close Button -->
        <ImageView
            android:id="@+id/btnCloseSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:rotation="270"
            app:tint="#616161" />
    </RelativeLayout>

    <!-- Language Items List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. English -->
        <LinearLayout
            android:id="@+id/itemLangEnglish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_language_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_lang_badge"
                android:gravity="center"
                android:text="EN"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameEnglish"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="#141414"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="United Kingdom / Global"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icRadioEnglish"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_circle_unselected" />
        </LinearLayout>

        <!-- 2. Bahasa Melayu -->
        <LinearLayout
            android:id="@+id/itemLangMalay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_language_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_lang_badge"
                android:gravity="center"
                android:text="BM"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameMalay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bahasa Melayu"
                    android:textColor="#141414"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Malaysia"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icRadioMalay"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_circle_unselected" />
        </LinearLayout>

        <!-- 3. Arabic -->
        <LinearLayout
            android:id="@+id/itemLangArabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_language_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_lang_badge"
                android:gravity="center"
                android:text="AR"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameArabic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العربية"
                    android:textColor="#141414"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arabic (Saudi Arabia)"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icRadioArabic"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_circle_unselected" />
        </LinearLayout>

        <!-- 4. Korean -->
        <LinearLayout
            android:id="@+id/itemLangKorean"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_language_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_lang_badge"
                android:gravity="center"
                android:text="KO"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameKorean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="한국어"
                    android:textColor="#141414"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Korean"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icRadioKorean"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_circle_unselected" />
        </LinearLayout>

        <!-- 5. Japanese -->
        <LinearLayout
            android:id="@+id/itemLangJapanese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_language_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_lang_badge"
                android:gravity="center"
                android:text="JA"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameJapanese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日本語"
                    android:textColor="#141414"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Japanese"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icRadioJapanese"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_circle_unselected" />
        </LinearLayout>

        <!-- 6. Chinese -->
        <LinearLayout
            android:id="@+id/itemLangChinese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_language_item_normal"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_lang_badge"
                android:gravity="center"
                android:text="ZH"
                android:textColor="#141414"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNameChinese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中文"
                    android:textColor="#141414"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simplified Chinese"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/icRadioChinese"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_circle_unselected" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
