<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnDetailBack"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="@dimen/touch_target_icon_padding"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailRequestNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="CRQ-20261020-0001" />

            <TextView
                android:id="@+id/tvDetailCreatedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                tools:text="Dihantar pada 20 Okt 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetailStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_category_chip_active"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/brand_magenta"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Dihantar" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Official Quotation Card (Only when officially issued/sent) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOfficialQuotation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#E8F5E9"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notice_official_quotation_available"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvQuotationNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="No. Sebut Harga: QUO-20261020-0012" />

                    <TextView
                        android:id="@+id/tvQuotationTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/brand_magenta"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Jumlah: RM 24,500.00" />

                    <TextView
                        android:id="@+id/tvQuotationValidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_gray"
                        android:textSize="11.5sp"
                        tools:text="Sah sehingga: 27 Okt 2026" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Status Notice Banner -->
            <TextView
                android:id="@+id/tvStatusNoticeBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="#FFF3E0"
                android:padding="12dp"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:visibility="gone"
                tools:text="Permintaan ini sedang disemak oleh pihak pengurusan Hafiz Travel &amp; Tours. Maklumat telah dikunci untuk semakan." />

            <!-- Travel Overview Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_travel_overview"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="Kategori: Umrah\nDestinasi: Makkah &amp; Madinah\nTarikh: 2026-11-01 hingga 2026-11-13 (12 Hari)" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Travellers & Room Requirements Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/summary_travellers_rooms"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailTravellersRooms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="Jemaah: 2 Dewasa Lelaki, 2 Dewasa Perempuan\nBilik: Quad\nSusunan Bilik:\n• Quad Lelaki (2/4)\n• Quad Perempuan (2/4)" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Custom Preferences Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wizard_stage_3_title"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailPreferences"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_dark"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="Penerbangan: Malaysia Airlines (Ekonomi, Terus)\nPengangkutan: Bas Persendirian\nSajian: Full Board" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons: Edit & Cancel -->
            <LinearLayout
                android:id="@+id/containerDetailActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnDetailEdit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_booking_primary_button"
                    android:text="@string/custom_travel_wizard_edit_title"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDetailCancel"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_category_chip_inactive"
                    android:text="@string/btn_cancel_request"
                    android:textColor="#D32F2F"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
