<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/passwordRequirementsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Password Strength Bar (4 states: Too Short, Weak, Medium, Strong) -->
    <LinearLayout
        android:id="@+id/passwordStrengthBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_weight="1"
            android:background="#E5E9EC"
            android:clipChildren="true">

            <View
                android:id="@+id/passwordStrengthBar"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:background="#E53935" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvPasswordStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#E53935"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password_requirements_header"
        android:textColor="@color/text_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <!-- Requirement 1: Min 8 chars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconReqLength"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pass_req_neutral"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/tvReqLength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/req_pass_min_length"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Requirement 2: Uppercase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconReqUppercase"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pass_req_neutral"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/tvReqUppercase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/req_pass_uppercase"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Requirement 3: Lowercase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconReqLowercase"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pass_req_neutral"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/tvReqLowercase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/req_pass_lowercase"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Requirement 4: Number -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconReqNumber"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pass_req_neutral"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/tvReqNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/req_pass_number"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Requirement 5: Special character -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="2dp">

            <ImageView
                android:id="@+id/iconReqSpecial"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_pass_req_neutral"
                android:contentDescription="Status" />

            <TextView
                android:id="@+id/tvReqSpecial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/req_pass_special"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Strong Password Status Pill -->
    <LinearLayout
        android:id="@+id/strongPasswordStatusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_verified"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_shield_check"
            app:tint="#047857"
            android:contentDescription="Shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/password_status_strong"
            android:textColor="#047857"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
