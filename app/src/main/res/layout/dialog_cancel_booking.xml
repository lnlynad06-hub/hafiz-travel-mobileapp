<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_dialog_luxury"
    android:elevation="14dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="22dp">

    <!-- Top Badge Icon -->
    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_icon_badge_fav_remove">

        <ImageView
            android:id="@+id/ivCancelDialogBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cancellation_policy"
            app:tint="#BE185D"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <!-- Dialog Title -->
    <TextView
        android:id="@+id/tvCancelDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/cancel_booking_title"
        android:textColor="#18181B"
        android:textSize="17.5sp"
        android:textStyle="bold" />

    <!-- Subtitle (Package name & Ref) -->
    <TextView
        android:id="@+id/tvCancelDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="#BE185D"
        android:textSize="11.5sp"
        android:textStyle="bold"
        tools:text="Pakej Umrah Rahmah • BKG-260924-ABCDEF" />

    <!-- Confirmation Description Message -->
    <TextView
        android:id="@+id/tvCancelDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:paddingHorizontal="6dp"
        android:text="@string/cancel_booking_confirm_message"
        android:textColor="#52525B"
        android:textSize="12sp" />

    <!-- Dynamic Quote Breakdown Card -->
    <LinearLayout
        android:id="@+id/layoutQuoteBreakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_detail_card"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvQuoteWorkingDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#27272A"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Working days before departure: 45 days" />

        <TextView
            android:id="@+id/tvQuoteCharge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#BE185D"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Cancellation Charge: RM 1,000 (15% of package price)" />

        <TextView
            android:id="@+id/tvQuoteDepositNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/cancel_quote_non_refundable_deposit"
            android:textColor="#71717A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvQuoteRefund"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#059669"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Estimated Refund: RM 500"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvQuoteRefundPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/cancel_quote_refund_period"
            android:textColor="#71717A"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvQuoteNoRefund"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cancel_quote_no_refund"
            android:textColor="#E11D48"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Cancellation Reason Input (Properly centered & balanced) -->
    <EditText
        android:id="@+id/etCancelReasonInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="52dp"
        android:background="@drawable/bg_dialog_input"
        android:gravity="center_vertical|start"
        android:hint="@string/cancel_booking_reason_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:lines="2"
        android:maxLines="3"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="#18181B"
        android:textColorHint="#94A3B8"
        android:textSize="12.5sp" />

    <!-- Irreversible Warning Note -->
    <TextView
        android:id="@+id/tvCancelIrreversibleNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/cancel_booking_irreversible_notice"
        android:textColor="#DC2626"
        android:textSize="11.5sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- Keep Booking Button (Secondary) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelKeep"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_cancel_dialog"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/cancel_booking_keep"
            android:textAllCaps="false"
            android:textColor="#3F3F46"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- Confirm Cancel Button (Destructive) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelConfirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_remove_confirm"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/cancel_booking_btn_confirm"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
