<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/privacyHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btnPrivacyBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_dark" />

        <ImageView
            android:id="@+id/ivPrivacyLogo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/logo"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPrivacyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/privacy_policy_title"
                android:textColor="@color/text_dark"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrivacySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/privacy_policy_subtitle"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Version Badge -->
        <TextView
            android:id="@+id/tvPrivacyVersionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_lang_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="v1.0"
            android:textColor="@color/brand_magenta"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Optional Open in Browser Action -->
        <ImageButton
            android:id="@+id/btnOpenInBrowser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/privacy_policy_open_browser"
            android:padding="10dp"
            android:src="@drawable/ic_share"
            android:visibility="gone"
            app:tint="@color/text_gray" />

    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/privacyProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/bg_loyalty_progress"
        android:visibility="visible" />

    <!-- Content Frame: WebView + Error Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/privacyWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error Layout with Retry Option -->
        <LinearLayout
            android:id="@+id/privacyErrorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_bg_light"
                android:padding="12dp"
                android:src="@drawable/ic_warning"
                app:tint="@color/brand_magenta"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvPrivacyErrorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/privacy_policy_error_title"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrivacyErrorDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/privacy_policy_error_desc"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrivacyRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_luxury_button"
                android:elevation="3dp"
                android:minWidth="140dp"
                android:paddingHorizontal="24dp"
                android:text="@string/privacy_policy_retry"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/privacyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- Consent Actions (Accept / Decline Buttons) -->
        <LinearLayout
            android:id="@+id/layoutConsentActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Neumorphic Decline Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrivacyDecline"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_neumorphic_decline_button"
                android:elevation="2dp"
                android:letterSpacing="0.03"
                android:stateListAnimator="@null"
                android:text="@string/privacy_policy_decline"
                android:textAllCaps="false"
                android:textColor="@color/brand_magenta"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- Magenta Neumorphic Accept Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrivacyAccept"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_neumorphic_magenta_button"
                android:elevation="4dp"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                android:text="@string/privacy_policy_accept"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- View-Only Mode Action (Already Accepted) -->
        <LinearLayout
            android:id="@+id/layoutViewOnlyActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lang_badge"
                android:drawableStart="@drawable/ic_check_circle_magenta"
                android:drawablePadding="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:text="@string/privacy_policy_already_accepted"
                android:textColor="@color/brand_magenta"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPrivacyClose"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_luxury_button"
                android:elevation="2dp"
                android:minWidth="100dp"
                android:paddingHorizontal="20dp"
                android:text="@string/privacy_policy_close"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
