<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_luxury"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/circle_bg_light"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_lock"
                app:tint="@color/pink_dark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_change_password"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/change_password_dialog_subtitle"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnClosePasswordDialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_close"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_gray" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="14dp"
        android:background="#E5E9EC" />

    <!-- Current Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/currentPasswordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_current_password_required"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/box_stroke_selector"
        app:boxBackgroundColor="@color/box_bg_selector"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:boxStrokeErrorColor="@color/error_red"
        app:hintEnabled="true"
        app:errorEnabled="false"
        app:errorIconDrawable="@null"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/pink_dark"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/pink_dark">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/currentPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:textColor="@color/input_text"
            android:textColorHint="@color/input_hint"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- New Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/newPasswordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/hint_new_password_required"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/box_stroke_selector"
        app:boxBackgroundColor="@color/box_bg_selector"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:boxStrokeErrorColor="@color/error_red"
        app:hintEnabled="true"
        app:errorEnabled="false"
        app:errorIconDrawable="@null"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/pink_dark"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/pink_dark">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/newPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:textColor="@color/input_text"
            android:textColorHint="@color/input_hint"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Requirements Checklist -->
    <include
        android:id="@+id/passwordRequirementsLayout"
        layout="@layout/layout_password_requirements"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />

    <!-- Confirm New Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/confirmNewPasswordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/hint_confirm_new_password_required"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/box_stroke_selector"
        app:boxBackgroundColor="@color/box_bg_selector"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1.5dp"
        app:boxStrokeErrorColor="@color/error_red"
        app:hintEnabled="true"
        app:errorEnabled="false"
        app:errorIconDrawable="@null"
        app:startIconDrawable="@drawable/ic_lock"
        app:startIconTint="@color/pink_dark"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/pink_dark">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirmNewPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:inputType="textPassword"
            android:textColor="@color/input_text"
            android:textColorHint="@color/input_hint"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelPasswordChange"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:background="@drawable/bg_google_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:text="@string/cancel"
            android:textColor="@color/text_gray"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePasswordChange"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_gradient_primary_button"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_update_password"
                android:textColor="@color/white"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
