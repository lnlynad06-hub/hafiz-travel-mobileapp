<resources>
    <!--  Default theme: Pink  -->
    <color name="pink_primary">#EC407A</color>
    <color name="pink_dark">#C2185B</color>
    <color name="pink_light">#FCE4EC</color>
    <color name="pink_accent">#FF80AB</color>
    <color name="white">#FFFFFF</color>
    <color name="background">#FFF8FA</color>
    <color name="text_dark">#212121</color>
    <color name="text_gray">#757575</color>
    <color name="field_border">#E0E0E0</color>
    <color name="error_red">#D32F2F</color>

    <!-- NEW: dedicated "card surface" color, separate from "white".
         In light mode it's the same as white so nothing visually changes.
         Needed because "white" is also used for text/icons on the pink hero
         (colorOnPrimary) which must stay white in BOTH themes - if we reused
         "white" for card backgrounds too, redefining it for dark mode would
         also turn that hero text dark. Use @color/surface for any card /
         panel background instead of @color/white going forward. -->
    <color name="surface">#FFFFFF</color>
</resources>