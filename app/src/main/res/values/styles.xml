<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================================================================= -->
    <!-- HAFIZ TRAVEL & TOURS — DESIGN SYSTEM FOUNDATION WIDGET STYLES     -->
    <!-- Native Android Material 3 Design System                           -->
    <!-- Preserves Luxury Editorial Pink/Ivory Identity                    -->
    <!-- ================================================================= -->

    <!-- Base Root Style Anchor for AAPT Dot Hierarchy -->
    <style name="Widget.HafizTravel" parent="" />

    <!-- ==================== 1. TEXT INPUT STYLES ==================== -->
    <!-- Visual Benchmark: Edit Profile 14dp Rounded Outline Field -->
    <style name="Widget.HafizTravel.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/box_stroke_selector</item>
        <item name="boxBackgroundColor">@color/box_bg_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxStrokeErrorColor">@color/error_red</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextColor">@color/pink_dark</item>
        <item name="startIconTint">@color/pink_dark</item>
        <item name="endIconTint">@color/pink_dark</item>
        <item name="errorIconDrawable">@null</item>
    </style>

    <style name="Widget.HafizTravel.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/input_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- ==================== 2. BUTTON STYLES ==================== -->
    <style name="Widget.HafizTravel.Button" parent="" />

    <!-- Primary CTA Button: Brand Magenta, 48dp minimum touch target -->
    <style name="Widget.HafizTravel.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target_button_height</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/brand_magenta</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="elevation">@dimen/elevation_low</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">@dimen/spacing_sm</item>
    </style>

    <!-- Secondary Outlined Button: Ivory Surface with subtle border -->
    <style name="Widget.HafizTravel.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_target_button_height</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="elevation">@dimen/elevation_none</item>
        <item name="iconTint">@color/brand_magenta</item>
        <item name="iconPadding">@dimen/spacing_sm</item>
    </style>

    <!-- Tonal / Light Pill Button (Stage controls, secondary options) -->
    <style name="Widget.HafizTravel.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/touch_target_button_height</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/service_bg</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="elevation">@dimen/elevation_none</item>
        <item name="iconTint">@color/brand_magenta</item>
        <item name="iconPadding">@dimen/spacing_sm</item>
    </style>

    <!-- ==================== 3. CARD STYLES ==================== -->
    <!-- Elevated Luxury Card: 16dp corners, soft 2dp depth -->
    <style name="Widget.HafizTravel.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_low</item>
        <item name="cardBackgroundColor">@color/card_surface</item>
    </style>

    <!-- Outlined Luxury Card: 16dp corners, flat depth with subtle stroke -->
    <style name="Widget.HafizTravel.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardBackgroundColor">@color/card_surface</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ==================== 4. DIALOG & MODAL STYLES ==================== -->
    <style name="Widget.HafizTravel.Dialog" parent="" />

    <style name="Widget.HafizTravel.Dialog.Container" parent="">
        <item name="android:background">@drawable/bg_dialog_luxury</item>
        <item name="android:padding">@dimen/spacing_md</item>
    </style>

    <!-- Standard 48dp Dialog Close Button -->
    <style name="Widget.HafizTravel.Dialog.CloseButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/touch_target_icon_padding</item>
        <item name="android:src">@drawable/ic_close</item>
        <item name="android:tint">@color/text_gray</item>
        <item name="android:contentDescription">@string/content_desc_close</item>
    </style>

    <!-- ==================== 5. TOP APP BAR STYLES ==================== -->
    <style name="Widget.HafizTravel.TopAppBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@color/surface</item>
        <item name="android:elevation">@dimen/elevation_low</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">@dimen/spacing_sm</item>
        <item name="android:paddingEnd">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.HafizTravel.TopAppBar.Title" parent="">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.HafizTravel.TopAppBar.NavigationButton" parent="">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">@dimen/touch_target_icon_padding</item>
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:tint">@color/text_dark</item>
        <item name="android:contentDescription">@string/content_desc_back</item>
    </style>

</resources>
