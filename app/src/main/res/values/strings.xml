    <string name="about_us_title">About Us</string>
    <string name="company_full_name">Hafiz Travel &amp; Tours Sdn Bhd</string>
    <string name="company_short_name">Hafiz Travel &amp; Tours</string>
    <string name="about_hero_blurb">Providing transparent Umrah guidance and quality tour packages, backed by a nationwide branch network across Malaysia.</string>
    <string name="about_who_we_are_title">Who We Are</string>
    <string name="about_who_we_are_body">Hafiz Travel &amp; Tours Sdn. Bhd. (No. KPK/LN: 10751) is a licensed travel agency and Umrah operator registered under the Ministry of Tourism, Arts and Culture (MOTAC), officially established in 2022. With expertise and experience in the travel and Umrah management industry, we are committed to providing transparent, organised and professional pilgrimage and tour services.\n\nBased in Larkin, Johor Bahru, we have grown with the support of over 10 active branches across Johor, Melaka, Selangor, Kuala Lumpur, Perak, Penang, Kedah, Kelantan, Terengganu and Pahang, making it easier for pilgrims and customers nationwide.</string>
    <string name="about_services_title">Our Services</string>
    <string name="about_service_umrah">Umrah and Ziarah Packages — pilgrimage trips to the Holy Land with experienced mutawif guidance, pilgrim welfare and comfortable accommodation. Includes Budget, Ladies-Only, and Honeymoon Packages, plus ziarah trips such as Istanbul and Dubai.</string>
    <string name="about_service_tour">International Tours — holiday packages to popular destinations across Asia and Europe.</string>
    <string name="about_why_choose_title">Why Choose Us</string>
    <string name="about_reason_registered">Licensed and registered agency (KPK/LN: 10751) — an official Umrah operator and travel agency compliant with Malaysian tourism regulations.</string>
    <string name="about_reason_branches">Wide branch network — local branches in 10 states for face-to-face consultation.</string>
    <string name="about_reason_guidance">Friendly and professional guidance — prioritising a smooth and fulfilling pilgrimage experience for every pilgrim.</string>
    <string name="label_vision">Vision</string>
    <string name="about_vision_body">To become a travel company that is always transparent, affordable, and the community\'s top choice.</string>
    <string name="label_mission">Mission</string>
    <string name="about_mission_body">To provide guaranteed packages at reasonable prices with service that delivers maximum customer satisfaction.</string>
