<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HafizTravel" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorPrimaryVariant">@color/pink_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pink_accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowAnimationStyle">@style/SeamlessFadeAnimation</item>
    </style>

    <!-- Global seamless ultra-fast fade animation for all activity transitions -->
    <style name="SeamlessFadeAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/nav_seamless_fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/nav_seamless_fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/nav_seamless_fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/nav_seamless_fade_out</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.HafizTravel">
        <item name="android:windowBackground">#FAF9F6</item>
        <item name="android:statusBarColor">#FAF9F6</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="LangPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="LuxuryDialogTheme" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/LuxuryDialogAnimation</item>
    </style>

    <style name="LuxuryDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_scale_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_scale_out</item>
    </style>

    <!-- Refined Hafiz Travel DatePicker Theme -->
    <style name="HafizDatePickerTheme" parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSecondary">@color/pink_dark</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="buttonBarPositiveButtonStyle">@style/HafizDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/HafizDialogButtonStyle</item>
    </style>

    <style name="HafizDialogButtonStyle" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/pink_dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>